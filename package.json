{
  "name": "fitts",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "pnpm --filter @fitts/desktop dev",
    "build": "pnpm --filter @fitts/desktop build",
    "release": "pnpm --filter @fitts/desktop dist:dir",
    "release:win": "pnpm --filter @fitts/desktop dist:win",
    "typecheck": "pnpm -r typecheck && tsc --noEmit -p scripts",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "pnpm --filter @fitts/desktop test && pnpm --filter @fitts/vite-plugin test && pnpm --filter @fitts/probes test && pnpm --filter @fitts/styles test",
    "test:e2e": "pnpm --filter @fitts/desktop test:e2e",
    "bench:chat": "pnpm --filter @fitts/desktop bench:chat",
    "verify:keys": "tsx scripts/verify/keys.ts",
    "verify:v6": "tsx scripts/verify/v6-muse.ts",
    "verify:v6:echo": "tsx scripts/verify/v6-muse.ts --echo",
    "demo:mirror": "node scripts/demo-mirror.mjs",
    "check:demo-chat": "pnpm --filter @fitts/desktop exec electron ../../scripts/check-demo-chat.cjs"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@meta-sam/parser": "0.1.0",
    "@types/node": "22.20.5",
    "@types/ws": "8.18.2",
    "dotenv": "18.0.9",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "openai": "7.45.1",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "ws": "8.22.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  }
}
