{
  "name": "@fitts/site",
  "version": "0.1.0",
  "private": true,
  "description": "fitts.allenzheng.com: what Fitts is, how it works, what it checks, and where to download it",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint -c eslint.config.mjs .",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test",
    "og": "node --experimental-strip-types --no-warnings scripts/og.mjs"
  },
  "dependencies": {
    "@fitts/probes": "workspace:*",
    "@fitts/schema": "workspace:*",
    "@fitts/styles": "workspace:*",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/rapier": "2.2.0",
    "geist": "1.8.2",
    "lucide-react": "1.63.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
