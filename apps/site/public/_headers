# Cloudflare Pages. Vite's hashed files never change at the same URL, so they cache for a year.
# Media names aren't hashed (a clip can be replaced in place), so they cache for 30 days.
# The pages themselves are revalidated, so a deploy shows at once.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/media/*
  Cache-Control: public, max-age=2592000

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
