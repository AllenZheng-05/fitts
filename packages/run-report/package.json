{
  "name": "@fitts/run-report",
  "version": "0.1.0",
  "private": true,
  "description": "Turns a Fitts run's event log and assets into a static web page you can share",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "export": "tsx src/cli.ts export",
    "site": "tsx src/cli.ts site",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fitts/schema": "workspace:*",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "geist": "1.8.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
